# ─── OpenAI API 키 (필수) ────────────────────────────────────────────────────
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ─── 금융감독원 금융상품통합비교공시 API 키 (선택) ─────────────────────────────
# 없으면 로컬 정적 데이터 자동 사용 (연금저축보험 실시간 조회 비활성화)
#
# 발급 절차:
#   1. https://finlife.fss.or.kr 접속
#   2. 우측 상단 [회원가입] → 개인/법인 선택 후 가입
#   3. 로그인 후 [마이페이지] → [API 활용 신청] 클릭
#   4. 활용 목적 작성 후 신청 → 당일~익일 승인 (무료)
#   5. 승인 후 [마이페이지] → [API 키 관리]에서 키 확인
#
# 지원 범위: 연금저축보험 상품 실시간 조회 (종신/실손/암/덴탈은 로컬 데이터 사용)
FSS_API_KEY=your_fss_api_key_here

# ─── Slack 슬래시 커맨드 서명 검증 (선택) ────────────────────────────────────
# Slack에서 "/덴탈조회 0x지갑주소" 같은 슬래시 커맨드로 블록체인 덴탈보험
# 현황을 조회하는 기능(/api/slack/commands)에 필요. 없으면 서명을 검증할
# 수 없어 해당 엔드포인트가 모든 요청을 거부한다.
# (blockchain-dental/.env의 SLACK_WEBHOOK_URL과는 별개 — 그쪽은
#  "블록체인 → Slack" 단방향 이벤트 알림용이고, 이건 "Slack → 조회" 양방향용)
#
# 발급 절차:
#   1. https://api.slack.com/apps → [Create New App] → From scratch
#   2. Slash Commands → Create New Command
#      Command: 원하는 이름 (예: /덴탈조회), Request URL: https://<공인 주소>/api/slack/commands
#      (localhost만으로는 Slack이 접근 못 함 — ngrok 등으로 외부 터널링 필요)
#   3. Basic Information → App Credentials → Signing Secret 값을 아래에 붙여넣기
#   4. Install App to Workspace
SLACK_SIGNING_SECRET=your_slack_signing_secret_here

# ─── B2B 파트너 API 관리자 인증 (선택, 신규) ─────────────────────────────────
# /admin/partners (파트너 API 키 발급/해지 화면) 로그인 비밀번호.
# 없으면 /admin/login에서 "ADMIN_PASSWORD가 설정되어 있지 않습니다" 오류로
# 로그인 자체가 불가능하다(파트너 키 관리 화면 접근 차단 — 안전한 기본값).
ADMIN_PASSWORD=change_me_before_using_admin_partners_page

# 관리자 로그인 세션 서명용 비밀키. 없으면 매 서버 재시작마다 무작위로
# 새로 생성되어(코드 내 기본값) 재시작 시 관리자 로그인이 풀린다 — 로그인을
# 유지하려면 고정값을 넣을 것 (예: python -c "import secrets; print(secrets.token_hex(32))").
FLASK_SECRET_KEY=

# 파트너 API(/api/partner/v1/dental/status) 예상 청구액 계산에 쓰는 호출당 단가(원).
PARTNER_PRICE_PER_CALL=10

# 파트너 API 분당 호출 제한 (키 1개 기준)
PARTNER_RATE_LIMIT_PER_MIN=60
